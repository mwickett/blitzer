# Copy to .env and configure your isolated development services. Never commit secrets.
DATABASE_URL="postgresql://blitzer:password@localhost:5432/blitzer"

# Clerk development instance. Register /api/webhooks for user.created/user.updated.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Optional analytics and feature flags. The public project key is not a secret.
NEXT_PUBLIC_POSTHOG_KEY=""
# Server ingest override; browser proxy destinations live in next.config.mjs.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Insights requires this key plus the llm-features flag.
OPENAI_API_KEY=""
# Required when loading the email module. Use a development provider account.
RESEND_API_KEY=""

# Canonical origin for pickup invitation links. Override in hosted environments.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Slack /whois. All three settings are required to allow a request.
SLACK_SIGNING_SECRET=""
SLACK_WHOIS_TEAM_ID=""
SLACK_WHOIS_USER_IDS=""

# Optional CI source-map upload. Sentry project/DSN configuration is in sentry.* and next.config.mjs.
# SENTRY_AUTH_TOKEN=""

# Only needed for explicit npm run db:seed. Supply your Clerk development IDs.
SEED_ORG_A=""
SEED_ORG_B=""
SEED_ORG_C=""
SEED_ANCHOR_USER=""
SEED_USER_2=""
SEED_USER_3=""
# Production database hostname fragment the seed command must refuse.
SEED_PROD_DB_HOST=""
