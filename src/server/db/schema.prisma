generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  clerk_user_id          String                   @unique
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @default(now()) @map("updated_at")
  username               String                   @unique
  avatarUrl              String?
  accentColor            String?                  @map("accent_color")
  dashboardLayout        Json?                    @map("dashboard_layout")
  preferredDeck          String?                  @map("preferred_deck")
  scoreEntryMode         ScoreEntryMode           @default(CARDS) @map("score_entry_mode")
  games                  GamePlayers[]
  scores                 Score[]
  createdGuests          GuestUser[]              @relation("CreatedGuests")
  OrganizationMembership OrganizationMembership[]
  hostedGames            Game[]                   @relation("GameHost")
  keyMoments             KeyMoment[]
}

enum ScoreEntryMode {
  CARDS
  TOTAL
}

enum GameKind {
  CIRCLE
  PICKUP
  LEGACY
}

model GuestUser {
  id               String        @id @default(uuid())
  name             String
  createdAt        DateTime      @default(now()) @map("created_at")
  createdById      String
  invitationSent   Boolean       @default(false)
  invitationSentAt DateTime?
  emailSent        String?
  organizationId   String?       @map("organization_id")
  createdBy        User          @relation("CreatedGuests", fields: [createdById], references: [id])
  games            GamePlayers[]
  scores           Score[]

  @@index([createdById])
  @@index([organizationId])
}

model Game {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now()) @map("created_at")
  endedAt        DateTime?     @map("ended_at")
  isFinished     Boolean       @default(false) @map("is_finished")
  winnerId       String?
  winThreshold   Int           @default(75) @map("win_threshold")
  organizationId String?       @map("organization_id")
  kind           GameKind      @default(CIRCLE)
  startedAt      DateTime?     @default(now()) @map("started_at")
  hostUserId     String?       @map("host_user_id")
  joinToken      String?       @unique @map("join_token")
  joinCode       String?       @unique @map("join_code")
  // Free-text note about a noteworthy moment; players can edit it any time.
  note           String?
  host           User?         @relation("GameHost", fields: [hostUserId], references: [id])
  players        GamePlayers[]
  rounds         Round[]
  story          GameStory?
  keyMoments     KeyMoment[]

  @@index([organizationId])
  @@index([hostUserId])
  @@index([kind, startedAt])
  @@index([createdAt, id])
}

// AI-written recap of a finished game. sourceKey fingerprints the rounds it
// was written from, so a corrected game gets a fresh story.
model GameStory {
  gameId    String   @id @map("game_id")
  story     String
  model     String
  sourceKey String   @map("source_key")
  createdAt DateTime @default(now()) @map("created_at")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

// A captioned photo of a memorable moment, stored in Vercel Blob. The blob is
// public by URL; pathname is kept so the file can be removed with the row.
model KeyMoment {
  id         String   @id @default(uuid())
  gameId     String   @map("game_id")
  roundId    String?  @map("round_id")
  uploaderId String?  @map("uploader_id")
  url        String
  pathname   String
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round      Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([gameId, createdAt])
  @@index([roundId])
  @@index([uploaderId])
}

model Round {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now()) @map("created_at")
  gameId     String
  round      Int
  revision   Int         @default(0)
  game       Game        @relation(fields: [gameId], references: [id])
  scores     Score[]
  keyMoments KeyMoment[]

  @@unique([gameId, round])
  @@index([gameId])
}

model Score {
  id                 String     @id @default(uuid())
  userId             String?
  guestId            String?
  // Cards played and Blitz pile left are null when the round's total was
  // typed directly ("Do math" entry); typedScore is set only in that case.
  totalCardsPlayed   Int?
  blitzPileRemaining Int?
  typedScore         Int?       @map("typed_score")
  createdAt          DateTime   @default(now()) @map("created_at")
  roundId            String
  updatedAt          DateTime   @default(now()) @map("updated_at")
  round              Round      @relation(fields: [roundId], references: [id])
  user               User?      @relation(fields: [userId], references: [id])
  guestUser          GuestUser? @relation(fields: [guestId], references: [id])

  @@index([userId])
  @@index([guestId])
  @@index([roundId])
}

model GamePlayers {
  id          String     @id @default(uuid())
  gameId      String
  userId      String?
  guestId     String?
  accentColor String?    @map("accent_color")
  deck        String?
  game        Game       @relation(fields: [gameId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])
  guestUser   GuestUser? @relation(fields: [guestId], references: [id])

  @@unique([gameId, userId], name: "gamePlayer_userId", map: "game_players_game_id_user_id")
  @@unique([gameId, guestId], name: "gamePlayer_guestId", map: "game_players_game_id_guest_id")
  @@index([userId])
  @@index([guestId])
}

model OrganizationMembership {
  id             String  @id
  organizationId String
  userId         String
  role           String?
  user           User    @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}
