# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local dev logs
dev.log
tunnel.log

# local env files
.env
.env*.local
# ignore all env variants except example
.env.*
!.env.example
# ensure tests env never tracked
.env.test
# `vercel env pull <file>` writes names like preview.env / dev.env, which the
# leading-dot patterns above do not match. Safe alongside !.env.example, since
# that name does not end in .env.
*.env


# vercel
.vercel

# prisma generated client
src/generated/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Cline MCP settings
cline_mcp_settings.json
claude_desktop_config.json

# Devin
.envrc

# clerk configuration (can include secrets)
/.clerk/

# worktrees
.worktrees/

# superpowers brainstorm sessions + playwright mcp state
.superpowers/
.playwright-mcp/
